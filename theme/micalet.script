# Micalet Plymouth theme
# Responsive background and softly pulsing logo.

# Uniform fallback background to prevent green bands.
Window.SetBackgroundTopColor(0.043, 0.204, 0.220);
Window.SetBackgroundBottomColor(0.043, 0.204, 0.220);

background_image = Image("background.png");
background_sprite = Sprite();

logo_source = Image("micalet-logo.png");
logo_sprite = Sprite();

screen_width = -1;
screen_height = -1;
screen_x = 0;
screen_y = 0;

# Recalculate all graphical elements for the current resolution.
fun layout_callback()
{
    screen_width = Window.GetWidth();
    screen_height = Window.GetHeight();
    screen_x = Window.GetX();
    screen_y = Window.GetY();

    background_scaled = background_image.Scale(
        screen_width,
        screen_height
    );

    background_sprite.SetImage(background_scaled);
    background_sprite.SetPosition(screen_x, screen_y, -100);

    logo_scale = 1.0;

    logo_max_width = screen_width * 0.30;
    logo_max_height = screen_height * 0.30;

    if (logo_source.GetWidth() > logo_max_width)
        logo_scale = logo_max_width / logo_source.GetWidth();

    if (logo_source.GetHeight() * logo_scale > logo_max_height)
        logo_scale = logo_max_height / logo_source.GetHeight();

    logo_width = Math.Int(logo_source.GetWidth() * logo_scale);
    logo_height = Math.Int(logo_source.GetHeight() * logo_scale);

    logo_image = logo_source.Scale(logo_width, logo_height);

    logo_sprite.SetImage(logo_image);
    logo_sprite.SetPosition(
        screen_x + (screen_width - logo_width) / 2,
        screen_y + (screen_height - logo_height) / 2,
        100
    );
}

layout_callback();

# Soft breathing animation.
logo_opacity_angle = 0.0;

fun refresh_callback()
{
    if (Window.GetWidth() != screen_width ||
        Window.GetHeight() != screen_height)
    {
        layout_callback();
    }

    logo_opacity_angle += ((2.0 * 3.14159265) / 50.0) * 0.20;

    if (logo_opacity_angle > 6.28318530)
        logo_opacity_angle -= 6.28318530;

    pulse = (Math.Cos(logo_opacity_angle) + 1.0) / 2.0;

    logo_sprite.SetOpacity(0.88 + (pulse * 0.12));
}

Plymouth.SetRefreshFunction(refresh_callback);

# Messages and disk-unlock prompts.
message_sprite = Sprite();
message_sprite.SetOpacity(0.0);

password_prompt_sprite = Sprite();
password_prompt_sprite.SetOpacity(0.0);

password_entry_sprite = Sprite();
password_entry_sprite.SetOpacity(0.0);

question_prompt_sprite = Sprite();
question_prompt_sprite.SetOpacity(0.0);

question_entry_sprite = Sprite();
question_entry_sprite.SetOpacity(0.0);

fun message_callback(text)
{
    message_image = Image.Text(text, 1.0, 1.0, 1.0, 1.0, "Sans 12");

    message_sprite.SetImage(message_image);
    message_sprite.SetX(screen_x + (screen_width - message_image.GetWidth()) / 2);
    message_sprite.SetY(screen_y + screen_height * 0.82);
    message_sprite.SetZ(200);
    message_sprite.SetOpacity(1.0);
}

Plymouth.SetMessageFunction(message_callback);

fun display_password_callback(prompt, bullet_count)
{
    prompt_image = Image.Text(prompt, 1.0, 1.0, 1.0, 1.0, "Sans 16");

    password_prompt_sprite.SetImage(prompt_image);
    password_prompt_sprite.SetX(screen_x + (screen_width - prompt_image.GetWidth()) / 2);
    password_prompt_sprite.SetY(screen_y + screen_height * 0.72);
    password_prompt_sprite.SetZ(210);
    password_prompt_sprite.SetOpacity(1.0);

    bullet_text = "";

    for (i = 0; i < bullet_count; i++)
        bullet_text += "*";

    if (bullet_count == 0)
        bullet_text = " ";

    entry_image = Image.Text(bullet_text, 1.0, 1.0, 1.0, 1.0, "Sans 16");

    password_entry_sprite.SetImage(entry_image);
    password_entry_sprite.SetX(screen_x + (screen_width - entry_image.GetWidth()) / 2);
    password_entry_sprite.SetY(screen_y + screen_height * 0.78);
    password_entry_sprite.SetZ(210);
    password_entry_sprite.SetOpacity(1.0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(prompt, entry)
{
    if (entry == "")
        entry = "<answer>";

    prompt_image = Image.Text(prompt, 1.0, 1.0, 1.0, 1.0, "Sans 16");

    question_prompt_sprite.SetImage(prompt_image);
    question_prompt_sprite.SetX(screen_x + (screen_width - prompt_image.GetWidth()) / 2);
    question_prompt_sprite.SetY(screen_y + screen_height * 0.72);
    question_prompt_sprite.SetZ(210);
    question_prompt_sprite.SetOpacity(1.0);

    entry_image = Image.Text(entry, 1.0, 1.0, 1.0, 1.0, "Sans 16");

    question_entry_sprite.SetImage(entry_image);
    question_entry_sprite.SetX(screen_x + (screen_width - entry_image.GetWidth()) / 2);
    question_entry_sprite.SetY(screen_y + screen_height * 0.78);
    question_entry_sprite.SetZ(210);
    question_entry_sprite.SetOpacity(1.0);
}

Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback()
{
    message_sprite.SetOpacity(0.0);
    password_prompt_sprite.SetOpacity(0.0);
    password_entry_sprite.SetOpacity(0.0);
    question_prompt_sprite.SetOpacity(0.0);
    question_entry_sprite.SetOpacity(0.0);
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
